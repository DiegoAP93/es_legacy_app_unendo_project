<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EtherSteamBoys"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".activities.AccesoActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".activities.RegistroActivity" />
        <activity android:name=".activities.LoginActivity" />
        <activity android:name=".activities.HomeActivity" />
        <activity android:name=".activities.PersonajesActivity" />
        <activity android:name=".activities.FichaPersonajeActivity" />
        <activity android:name=".activities.ObjetosActivity" />
        <activity android:name=".activities.FichaObjetoActivity" />
        <activity android:name=".activities.EnemigosActivity" />
        <activity android:name=".activities.FichaEnemigoActivity" />
        <activity android:name=".activities.DadosActivity" />
        <activity android:name=".activities.PerfilActivity" />

    </application>

</manifest>
