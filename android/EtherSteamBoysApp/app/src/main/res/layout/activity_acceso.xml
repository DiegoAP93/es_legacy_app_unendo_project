<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/bg_dark"
    android:padding="32dp">

    <!-- Logo -->
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center"
        android:contentDescription="@string/accs_logo_descrp"
        android:scaleType="fitCenter"
        android:src="@mipmap/acess_es_legacy_logo" />

    <View android:layout_width="0dp" android:layout_height="48dp" />

    <!-- Botón Inicio Sesión -->
    <Button
        android:id="@+id/btnInicioSesion"
        style="@style/GoldButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/inicio_sesion"
        android:layout_marginBottom="16dp" />

    <!-- Botón Registro -->
    <Button
        android:id="@+id/btnRegistro"
        style="@style/GoldButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/registro"
        android:backgroundTint="@null"
        android:background="@drawable/bg_button_gold" />

</LinearLayout>
