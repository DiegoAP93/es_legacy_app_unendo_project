<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/ToolbarStyle"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/registro"
            android:textColor="@color/bg_dark"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@color/bg_medium"
            android:margin="16dp">

            <!-- Nombre -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nombre"
                android:textColor="@color/text_gold"
                android:textStyle="bold"
                android:textSize="13sp"
                android:letterSpacing="0.08"
                android:layout_marginBottom="4dp" />
            <EditText
                android:id="@+id/etNombre"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:textColor="@color/text_primary"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:inputType="textPersonName"
                android:layout_marginBottom="16dp" />

            <!-- Nombre Usuario -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nombre_usuario"
                android:textColor="@color/text_gold"
                android:textStyle="bold"
                android:textSize="13sp"
                android:letterSpacing="0.08"
                android:layout_marginBottom="4dp" />
            <EditText
                android:id="@+id/etNombreUsuario"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:textColor="@color/text_primary"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:inputType="textNoSuggestions"
                android:layout_marginBottom="16dp" />

            <!-- Contraseña -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/contrasena"
                android:textColor="@color/text_gold"
                android:textStyle="bold"
                android:textSize="13sp"
                android:letterSpacing="0.08"
                android:layout_marginBottom="4dp" />
            <EditText
                android:id="@+id/etContrasena"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:textColor="@color/text_primary"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:inputType="textPassword"
                android:layout_marginBottom="16dp" />

            <!-- Correo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/correo"
                android:textColor="@color/text_gold"
                android:textStyle="bold"
                android:textSize="13sp"
                android:letterSpacing="0.08"
                android:layout_marginBottom="4dp" />
            <EditText
                android:id="@+id/etCorreo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_field"
                android:textColor="@color/text_primary"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:inputType="textEmailAddress"
                android:layout_marginBottom="16dp" />

            <!-- Checkbox newsletter -->
            <CheckBox
                android:id="@+id/cbNewsletter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:text="Deseo recibir notificaciones de Ether&amp;SteamBoys sobre actualizaciones del juego, nuevos productos y cualquier información de interés sobre el juego y sus productos."
                android:buttonTint="@color/gold_primary"
                android:layout_marginBottom="24dp" />

            <!-- Botón Registrar -->
            <Button
                android:id="@+id/btnRegistrar"
                style="@style/GoldButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/registrar"
                android:paddingStart="32dp"
                android:paddingEnd="32dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
