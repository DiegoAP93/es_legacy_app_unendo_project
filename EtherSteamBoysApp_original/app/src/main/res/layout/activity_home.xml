<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/ToolbarStyle"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home"
            android:textColor="@color/bg_dark"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />
    </androidx.appcompat.widget.Toolbar>

    <!-- Imagen de fondo / arte -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivHomeBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher"
            android:alpha="0.3"
            android:contentDescription="Fondo" />

        <!-- Menú de opciones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tvPersonajes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/personajes"
                android:textColor="@color/text_gold"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="20dp"
                android:padding="8dp" />

            <TextView
                android:id="@+id/tvObjetos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/objetos"
                android:textColor="@color/text_gold"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="20dp"
                android:padding="8dp" />

            <TextView
                android:id="@+id/tvEnemigos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/enemigos"
                android:textColor="@color/text_gold"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="20dp"
                android:padding="8dp" />

            <TextView
                android:id="@+id/tvDados"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dados"
                android:textColor="@color/text_gold"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="20dp"
                android:padding="8dp" />

            <TextView
                android:id="@+id/tvPerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perfil"
                android:textColor="@color/text_gold"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="20dp"
                android:padding="8dp" />

            <TextView
                android:id="@+id/tvSalir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/salir"
                android:textColor="@color/red_danger"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:padding="8dp" />

        </LinearLayout>
    </FrameLayout>

</LinearLayout>
